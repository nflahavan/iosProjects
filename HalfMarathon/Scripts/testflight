#!/bin/bash
# Archive HalfMarathon and upload it to App Store Connect, where it becomes a TestFlight build.
#
#   HalfMarathon/Scripts/testflight
#
# Signs and uploads as the Apple ID signed in to Xcode (Settings ▸ Accounts), which
# lets Xcode make the distribution certificate and profile itself. Without one,
# an App Store Connect API key works instead, kept outside the repo:
#   ~/.appstoreconnect/halfmarathon.env          KEY_ID=…  ISSUER_ID=…
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8   (mode 600)
#
# Each upload needs a build number higher than the last, so it's the time:
# 202610181102 sorts after every earlier build without anything to remember.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="$HOME/.appstoreconnect/halfmarathon.env"
BUILD=$(date +%Y%m%d%H%M)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

AUTH=(-allowProvisioningUpdates)
if [[ -f "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
    KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${KEY_ID}.p8"
    [[ -f "$KEY_PATH" ]] || { echo "Missing $KEY_PATH" >&2; exit 1; }
    AUTH+=(-authenticationKeyPath "$KEY_PATH"
           -authenticationKeyID "$KEY_ID"
           -authenticationKeyIssuerID "$ISSUER_ID")
fi

cat > "$WORK/ExportOptions.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key><string>app-store-connect</string>
    <key>destination</key><string>upload</string>
    <key>teamID</key><string>9K49YB68EN</string>
    <key>signingStyle</key><string>automatic</string>
    <key>uploadSymbols</key><true/>
</dict>
</plist>
EOF

echo "Archiving build ${BUILD}…"
xcodebuild archive -project "$ROOT/HalfMarathon.xcodeproj" -scheme HalfMarathon \
    -destination 'generic/platform=iOS' -archivePath "$WORK/HalfMarathon.xcarchive" \
    CURRENT_PROJECT_VERSION="${BUILD}" "${AUTH[@]}" -quiet

echo "Uploading…"
xcodebuild -exportArchive -archivePath "$WORK/HalfMarathon.xcarchive" \
    -exportOptionsPlist "$WORK/ExportOptions.plist" -exportPath "$WORK/export" \
    "${AUTH[@]}" -quiet

echo "Uploaded build ${BUILD}. It shows in TestFlight once App Store Connect finishes processing (usually 5–15 minutes)."
